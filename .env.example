# Copy to .env and fill in. Never commit .env.

# --- Required ---
# JDBC URL (not the postgres:// form some hosts show)
DATABASE_URL=jdbc:postgresql://localhost:5432/snipp
SPRING_DATASOURCE_USERNAME=snipp
SPRING_DATASOURCE_PASSWORD=snipp
# At least 32 characters; generate with: openssl rand -base64 48
APP_JWT_SECRET=

# --- Optional (defaults shown) ---
# APP_JWT_EXPIRATION_MS=86400000
# Comma-separated frontend origins allowed by CORS
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# APP_RATE_LIMIT_AUTH_PER_MINUTE=10
# APP_RATE_LIMIT_CREATE_PER_MINUTE=30
# In-memory redirect cache (short code -> target URL)
# APP_REDIRECT_CACHE_SPEC=maximumSize=10000,expireAfterWrite=10m
# APP_LOG_LEVEL=INFO
# SERVER_PORT=8080
# FORWARD_HEADERS_STRATEGY=native
# JPA_DDL_AUTO=validate
